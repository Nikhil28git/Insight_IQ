# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
venv2/
rag_env/
.venv/
env/
ENV/
env.bak/

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# dotenv / secrets
.env
.env.*

# Chroma / DB / caches
chroma_db/
*.sqlite3

# Build / temp files
*.log
*.tmp
temp_*.pdf

# Jupyter
.ipynb_checkpoints/

# Streamlit (theme config is tracked; secrets are not)
.streamlit/*
!.streamlit/config.toml

# Outputs (optional — uncomment if you don't want generated PDFs/videos tracked)
# pdfs/*/images/
# videos/*/chunks/

# Saved chat history (local, may contain query text)
chat_history.json
chat_history.json.tmp

# Extracted audio (large, regenerated by the pipeline; GitHub rejects files >100MB)
videos/*/audio/
